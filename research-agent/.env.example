# Copy to .env and fill in. Restart the app after editing.

# Required (both free)
GROQ_API_KEY=            # https://console.groq.com/keys
GOOGLE_API_KEY=          # https://aistudio.google.com/apikey

# Optional (free)
IEEE_API_KEY=            # https://developer.ieee.org
SEMANTIC_SCHOLAR_API_KEY=  # https://www.semanticscholar.org/product/api
CONTACT_EMAIL=           # sent to OpenAlex as a courtesy; leave blank if you prefer

# Model overrides
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODELS=gemini-flash-latest,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-lite-latest
# EMBED_MODEL=gemini-embedding-001
